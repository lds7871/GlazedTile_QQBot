# Spring Boot 应用配置示例文件
# 复制本文件为 application.yml 并根据实际环境修改配置

spring:
  application:
    name: Auto_Scheduled_Task
  config:
    import: classpath:config.properties
  session:
    store-type: memory
    timeout: 1800  # 30 分钟
    cookie:
      http-only: true
      max-age: 1800 
      name: JSESSIONID
      path: /
      secure: false
  datasource:
    # MySQL 数据库连接 URL
    url: jdbc:mysql://YOUR_DB_HOST:3306/YOUR_DB_NAME?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    # 数据库用户名
    username: YOUR_DB_USERNAME
    # 数据库密码
    password: YOUR_DB_PASSWORD
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: none
    generate-ddl: false
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQL8Dialect
        format_sql: true
  sql:
    init:
      mode: never

# 安全配置
security:
  # IP白名单配置 - 只允许本地和指定IP访问
  ip-whitelist-enabled: true  # 是否启用IP白名单过滤，生产环境建议设置为 true
  # IP白名单列表 - 允许访问的IP地址
  ip-whitelist:
    - 127.0.0.1           # IPv4 本地环回
    - ::1                 # IPv6 本地环回
    - localhost           # 本地主机名
    - 0:0:0:0:0:0:0:1    # IPv6 完整形式
    - 999.999.999.999     # 指定服务器IP

  
  # Pass Token配置 - 通过令牌绕过IP白名单限制
  pass-token-enabled: true  # 是否启用pass_token功能，生产环境建议设置为 true
  # Pass Token列表 - 允许通过的令牌（可以绕过IP白名单）
  pass-tokens:
    - "00000"   
    - "AAAA"   
    # 令牌可以通过以下方式在请求中传递：
    # 1. Authorization header: "Authorization: Bearer your-secret-token-1"
    # 2. Custom header: "X-Pass-Token: your-secret-token-1"
    # 3. Query parameter: "/api/endpoint?pass_token=your-secret-token-1"


# # CORS 跨域配置（可选）
# cors:
#   allowed-origins: http://zh-company.top,http://localhost:5174,http://127.0.0.1:5174
#   allowed-methods: GET,POST,PUT,DELETE,OPTIONS
#   allowed-headers: "*"
#   allow-credentials: true
#   max-age: 3600

server:
  port: 8090
  servlet:
    context-path: /

logging:
  level:
    root: INFO
    LDS.Person: DEBUG
    org.springframework.web: WARN                    # 改为 WARN，屏蔽 DEBUG 级别的日志
    org.springframework.web.servlet.DispatcherServlet: WARN  # 屏蔽 DispatcherServlet 的 DEBUG 日志
    org.springframework.web.servlet.handler: WARN   # 屏蔽路由处理器的 DEBUG 日志
    org.apache.coyote: WARN                         # 屏蔽 Tomcat HTTP 解析错误日志
    org.apache.coyote.http11: WARN                  # 屏蔽 HTTP/1.1 处理器的日志
    org.apache.tomcat: WARN                         # 屏蔽 Tomcat 的 DEBUG 日志
    org.hibernate.SQL: DEBUG
    com.baomidou.mybatisplus: DEBUG
